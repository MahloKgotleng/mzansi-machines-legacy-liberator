       IDENTIFICATION DIVISION.
       PROGRAM-ID. MINING-PAYROLL-1987.
       AUTHOR. UNKNOWN-DEVELOPER.
       DATE-WRITTEN. 1987-03-15.
      *============================================================
      * LEGACY PAYROLL MODULE - PLATINUM MINE NORTHWEST PROVINCE
      * NO DOCUMENTATION EXISTS. LAST MAINTAINED 2003.
      *============================================================
       
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  EMPLOYEE-ID           PIC 9(6).
       01  EMPLOYEE-NAME         PIC X(20).
       01  EMPLOYEE-SURNAME      PIC X(20).
       01  RSA-ID                PIC 9(13).
       01  HOME-ADDRESS          PIC X(30).
       01  DEPARTMENT            PIC X(10).
       01  JOB-GRADE             PIC 9(1).
       01  BASIC-SALARY          PIC 9(6).
       01  MEDICAL-AID-NUMBER    PIC 9(10).
       01  SAFETY-INCIDENT-COUNT PIC 9(2).
       01  INCIDENT-DETAILS      PIC X(50).
       01  NEXT-OF-KIN-NAME      PIC X(20).
       01  NEXT-OF-KIN-PHONE     PIC X(15).
       01  BANK-ACCOUNT-NUMBER   PIC 9(10).
       01  BANK-BRANCH-CODE      PIC 9(4).
       
       PROCEDURE DIVISION.
       MAIN-PARAGRAPH.
           PERFORM CALCULATE-PAY
           PERFORM LOG-TO-SYSOUT
           PERFORM SAFETY-INCIDENT-ESCALATION
           DISPLAY "NO TAX CALCULATION MODULE FOUND"
           DISPLAY "DEDUCTIONS HARD-CODED IN BATCH JOB JCL001"
           STOP RUN.
       
       CALCULATE-PAY.
           COMPUTE BASIC-SALARY = 0
           IF JOB-GRADE = 1
               COMPUTE BASIC-SALARY = 10000
           ELSE IF JOB-GRADE = 2
               COMPUTE BASIC-SALARY = 12000
           ELSE IF JOB-GRADE = 3
               COMPUTE BASIC-SALARY = 14000
           ELSE IF JOB-GRADE = 4
               COMPUTE BASIC-SALARY = 16000
           ELSE IF JOB-GRADE = 5
               COMPUTE BASIC-SALARY = 18000
           ELSE
               DISPLAY "INVALID JOB GRADE"
           END-IF.
       
       LOG-TO-SYSOUT.
           DISPLAY "PAYROLL REPORT FOR EMPLOYEE " EMPLOYEE-ID
           DISPLAY "NAME: " EMPLOYEE-NAME ", SURNAME: " 
                   EMPLOYEE-SURNAME
           DISPLAY "RSA ID: " RSA-ID
           DISPLAY "HOME ADDRESS: " HOME-ADDRESS
           DISPLAY "DEPARTMENT: " DEPARTMENT
           DISPLAY "JOB GRADE: " JOB-GRADE
           DISPLAY "BASIC SALARY: " BASIC-SALARY
           DISPLAY "MEDICAL AID NUMBER: " MEDICAL-AID-NUMBER
           DISPLAY "SAFETY INCIDENT COUNT: " SAFETY-INCIDENT-COUNT
           DISPLAY "INCIDENT DETAILS: " INCIDENT-DETAILS
           DISPLAY "NEXT-OF-KIN NAME: " NEXT-OF-KIN-NAME
           DISPLAY "NEXT-OF-KIN PHONE: " NEXT-OF-KIN-PHONE
           DISPLAY "BANK ACCOUNT NUMBER: " BANK-ACCOUNT-NUMBER
           DISPLAY "BANK BRANCH CODE: " BANK-BRANCH-CODE.
       
       SAFETY-INCIDENT-ESCALATION.
           IF SAFETY-INCIDENT-COUNT > 5
               DISPLAY "INCIDENT ESCALATION REQUIRED"
           END-IF.
